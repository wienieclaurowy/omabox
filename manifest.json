{
  "schemaVersion": 1,
  "id": "io.github.wienieclaurowy.omabox",
  "name": "Omabox",
  "version": "1.0.0-rc.1",
  "author": "wienieclaurowy",
  "description": "Quiet inbox: a once-a-day feed digest and the notification history in one bar widget",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Omabox",
    "category": "Notifications",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "readingFont": "iA Writer Quattro S",
      "readingMeasure": 70,
      "readerFontDelta": 0,
      "hints": false
    },
    "schema": [
      {
        "key": "readingFont",
        "type": "string",
        "label": "Reading font",
        "defaultValue": "iA Writer Quattro S",
        "description": "Font for post text in the reader."
      },
      {
        "key": "readingMeasure",
        "type": "integer",
        "label": "Reader line length (characters)",
        "min": 45,
        "max": 100,
        "step": 5,
        "defaultValue": 70
      },
      {
        "key": "readerFontDelta",
        "type": "integer",
        "label": "Reader text size",
        "min": -4,
        "max": 10,
        "step": 1,
        "defaultValue": 0,
        "description": "Relative to the theme; + and - in the reader change it."
      },
      {
        "key": "hints",
        "type": "boolean",
        "label": "Key hints",
        "defaultValue": false,
        "description": "Show the key hints line; ? in the panel toggles it."
      }
    ]
  }
}
